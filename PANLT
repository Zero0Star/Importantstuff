                    show(picker)
                end)
            else
                local input = make("TextBox", page, {Size = UDim2.new(1, -8, 0, 35), BackgroundColor3 = C.dark, TextColor3 = C.white, FontFace = bodyFont, TextSize = 14, ClearTextOnFocus = false, Text = valueText(), PlaceholderText = cfg.Placeholder or (kind == "color" and "RRGGBB" or "Enter value"), Visible = false, ZIndex = 17})
                round(input, 6); stroke(input, 0.4, 1)
                connect(b.Activated, function() if not cfg.Disabled then input.Visible = not input.Visible; input.Text = valueText() end end)
                if kind == "slider" then
                    local slider = make("TextButton", page, {Size = UDim2.new(1, -22, 0, 24), BackgroundColor3 = C.dark2, Text = "", AutoButtonColor = false, ZIndex = 17})
                    round(slider, 5); stroke(slider, 0.4, 1)
