    closeRadarBtn.Text = "×"
    closeRadarBtn.TextColor3 = Color3.fromRGB(180, 255, 200)
    closeRadarBtn.TextSize = 16
    closeRadarBtn.Font = Enum.Font.GothamBold
    closeRadarBtn.BackgroundTransparency = 1
    closeRadarBtn.BorderSizePixel = 0
