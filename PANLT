            local function valueText()
                if kind == "toggle" then return o.Value and "ON" or "OFF" end
                if kind == "color" then return o.Value:ToHex() end
                if type(o.Value) == "table" then
                    local result = {}
                    for _, item in ipairs(o.Values) do if o.Value[item] then table.insert(result, item) end end
                    return #result > 0 and table.concat(result, ", ") or "None"
