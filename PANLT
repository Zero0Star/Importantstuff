                    local drag
                    local function slide(pos)
                        local width = slider.AbsoluteSize.X
                        if width <= 0 then return end
                        local f = math.clamp((pos.X - slider.AbsolutePosition.X) / width, 0, 1)
                        local factor = 10 ^ (cfg.Rounding or 0)
                        local v = math.clamp(math.round((lo + (hi - lo) * f) * factor) / factor, lo, hi)
                        if v ~= o.Value then o:SetValue(v) end
                    end
                    connect(slider.InputBegan, function(inputObject)
                        if cfg.Disabled then return end
                        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then drag = inputObject; slide(inputObject.Position) end
                    end)
                    connect(UIS.InputChanged, function(inputObject)
