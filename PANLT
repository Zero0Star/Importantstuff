restoreNightVision = function()
    if not lightingBackup then
        nightVisionEnabled = false
        setNvButtonState(false)
        nvDescription.Text = "Illuminate everything"
        return false
    end
    if nvBloom and nvBloom.Parent then nvBloom:Destroy() end
    nvBloom = nil
    for prop, value in pairs(lightingBackup.values) do
        pcall(function() Lighting[prop] = value end)
    end
    for _, item in ipairs(lightingBackup.atmospheres) do
        if item.object.Parent then
            pcall(function()
                item.object.Density = item.density
                item.object.Haze = item.haze
            end)
        end
    end
    for _, effect in ipairs(lightingBackup.removed) do effect.Parent = Lighting end
    lightingBackup, nightVisionEnabled = nil, false
    nvDescription.Text = "Illuminate everything"
    setNvButtonState(false)
    return true
end

local function enableNightVision()
    if nightVisionEnabled then return true end
    local names = {"GlobalShadows", "Brightness", "ExposureCompensation", "Ambient",
        "OutdoorAmbient", "FogEnd", "FogColor"}
    local backup = {values = {}, removed = {}, atmospheres = {}}
    for _, prop in ipairs(names) do backup.values[prop] = Lighting[prop] end
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") then
            table.insert(backup.removed, v:Clone())
        elseif v:IsA("Atmosphere") then
            table.insert(backup.atmospheres, {object = v, density = v.Density, haze = v.Haze})
        end
    end
    lightingBackup = backup
    Lighting.GlobalShadows = false
    Lighting.Brightness = 4
    Lighting.ExposureCompensation = 0.4
    Lighting.Ambient = Color3.fromRGB(120, 140, 180)
    Lighting.OutdoorAmbient = Color3.fromRGB(140, 160, 200)
    Lighting.FogEnd = 100000
    Lighting.FogColor = Color3.fromRGB(10, 20, 40)
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") then
            v:Destroy()
        elseif v:IsA("Atmosphere") then
            v.Density = 0.05
            v.Haze = 0
        end
    end
    nvBloom = Instance.new("BloomEffect")
    nvBloom.Name = "HardCoreAdminNightVisionBloom"
    nvBloom.Intensity = 0.25
    nvBloom.Size = 20
    nvBloom.Threshold = 1.5
    nvBloom.Parent = Lighting
    nightVisionEnabled = true
    nvDescription.Text = "Illuminate everything"
    setNvButtonState(true)
    return true
end

