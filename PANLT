local function resetLanding()
    currentPage = 0
    switching = false
    back.Visible = false
    for index, page in pairs(pages) do
        page.Visible = index == 0
        page.GroupTransparency = index == 0 and 0 or 1
        page.Position = UDim2.fromOffset(0, 0)
    end
end
local function navigate(index)
    if phase ~= "open" or switching or currentPage == index then return end
    switching = true
    clickSound()
    local from = pages[currentPage]
    local into = pages[index]
    local direction = index == 0 and -1 or 1
    into.Visible = true
    into.Position = UDim2.fromOffset(direction * 48, 0)
    into.GroupTransparency = 1
    tween(from, {Position = UDim2.fromOffset(-direction * 34, 0), GroupTransparency = 1}, 0.22)
    tween(into, {Position = UDim2.fromOffset(0, 0), GroupTransparency = 0}, 0.39,
        Enum.EasingStyle.Quint, easeOut)
    currentPage = index
    back.Visible = index ~= 0
    local token = stateToken
    task.delay(0.4, function()
        if not alive or token ~= stateToken then return end
        from.Visible = false
        from.Position = UDim2.fromOffset(0, 0)
        switching = false
    end)
end
for i, item in ipairs(categories) do
    connect(item.button.Activated, function() navigate(i) end)
end
connect(back.Activated, function() navigate(0) end)

local function openPanel()
    if phase == "open" or phase == "opening" then return end
    stateToken = stateToken + 1
    local token = stateToken
    phase = "opening"
    resetLanding()
    layout()
    dim.Visible = true
    fx.Visible = true
    panel.Visible = true
    outerHalo.Visible, goldEdge.Visible = true, true
    mobileIcon.Visible = false
    unlockCursor()
    panel.Position = UDim2.fromScale(0.5, 0.56)
    outerHalo.Position, goldEdge.Position = panel.Position, panel.Position
    panel.GroupTransparency = 1
    panelScale.Scale, outerHaloScale.Scale, goldEdgeScale.Scale = 0.88, 0.88, 0.88
    outerHaloStroke.Transparency, goldEdgeStroke.Transparency = 1, 1
    tween(dim, {BackgroundTransparency = 0.59}, 0.38)
    tween(panel, {Position = UDim2.fromScale(0.5, 0.5), GroupTransparency = 0}, 0.55,
        Enum.EasingStyle.Back, easeOut)
    tween(panelScale, {Scale = 1}, 0.5, Enum.EasingStyle.Quint, easeOut)
    tween(outerHalo, {Position = UDim2.fromScale(0.5, 0.5)}, 0.55, Enum.EasingStyle.Back, easeOut)
    tween(goldEdge, {Position = UDim2.fromScale(0.5, 0.5)}, 0.55, Enum.EasingStyle.Back, easeOut)
    tween(outerHaloScale, {Scale = 1}, 0.5, Enum.EasingStyle.Quint, easeOut)
    tween(goldEdgeScale, {Scale = 1}, 0.5, Enum.EasingStyle.Quint, easeOut)
    tween(outerHaloStroke, {Transparency = 0.73}, 0.45)
    tween(goldEdgeStroke, {Transparency = 0.08}, 0.45)
    task.delay(0.56, function()
        if alive and stateToken == token then phase = "open" end
    end)
end
local function closePanel()
    if phase == "closed" or phase == "closing" then return end
    stateToken = stateToken + 1
    local token = stateToken
    phase = "closing"
    switching = false
    toast.Visible = false
    tween(dim, {BackgroundTransparency = 1}, 0.33)
    tween(panel, {Position = UDim2.fromScale(0.5, 0.56), GroupTransparency = 1},
        0.31, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    tween(panelScale, {Scale = 0.91}, 0.31, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    tween(outerHalo, {Position = UDim2.fromScale(0.5, 0.56)}, 0.31,
        Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    tween(goldEdge, {Position = UDim2.fromScale(0.5, 0.56)}, 0.31,
        Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    tween(outerHaloScale, {Scale = 0.91}, 0.31, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    tween(goldEdgeScale, {Scale = 0.91}, 0.31, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    tween(outerHaloStroke, {Transparency = 1}, 0.28)
    tween(goldEdgeStroke, {Transparency = 1}, 0.28)
    task.delay(0.34, function()
        if not alive or token ~= stateToken then return end
        phase = "closed"
        restoreCursor()
        panel.Visible = false
        outerHalo.Visible, goldEdge.Visible = false, false
        dim.Visible = false
        fx.Visible = false
        layout()
    end)
end
local function togglePanel()
    clickSound()
    if phase == "open" or phase == "opening" then closePanel() else openPanel() end
end
