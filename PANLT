                    round(fill, 5); gradient(fill, {C.bronze, C.cyan, C.pale}, 0)
                    local lo, hi = cfg.Min or 0, cfg.Max or 100
                    local function renderSlider(v) fill.Size = UDim2.fromScale(hi == lo and 0 or math.clamp((v - lo) / (hi - lo), 0, 1), 1) end
