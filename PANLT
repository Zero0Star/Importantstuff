        end
    end
    lightingBackup = backup
    Lighting.GlobalShadows = false
    Lighting.Brightness = 4
    Lighting.ExposureCompensation = 0.4
    Lighting.Ambient = Color3.fromRGB(120, 140, 180)
    Lighting.OutdoorAmbient = Color3.fromRGB(140, 160, 200)
