        local count = 0

        if root and selfHumanoid and selfHumanoid.Health > 0 then
            local origin = root.Position
            local cf = root.CFrame

            local function Plot(target, position)
                local offset = position - origin
                local horizontal = Vector3.new(offset.X, 0, offset.Z)
                local distance = horizontal.Magnitude
                if distance > RANGE then
                    return
                end

                local right = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
                local forward = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
                local x = horizontal:Dot(right) / RANGE * RADAR_RADIUS
                local y = -horizontal:Dot(forward) / RANGE * RADAR_RADIUS

                local dot = GetDot(target)
                dot.Position = UDim2.new(0.5, x, 0.5, y)
                visible[target] = true
                count += 1
            end

            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local character = player.Character
                    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                    local targetRoot = character and character:FindFirstChild("HumanoidRootPart")
                    if humanoid and humanoid.Health > 0 and targetRoot then
                        Plot(player, targetRoot.Position)
                    end
                end
            end

            for model in pairs(JeffModels) do
                if model:IsDescendantOf(workspace) then
                    local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
                    if part then
                        Plot(model, model:GetPivot().Position)
                    end
                else
                    JeffModels[model] = nil
                end
            end
        end

