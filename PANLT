local elapsed, acc = 0, 0
connect(RS.RenderStepped, function(dt)
    if not alive or not animEnabled then return end
    elapsed, acc = elapsed + dt, acc + dt
    if acc < 1 / 30 then return end
    acc = acc % (1 / 30)
    if mobileIcon.Visible then
        mobileScale.Scale = 1 + math.sin(elapsed * 2.4) * 0.052
        mobileIcon.Rotation = math.sin(elapsed * 1.45) * 2.4
        mobileBorderGrad.Rotation = (elapsed * 33) % 360
    end
    if not panel.Visible then return end
    panelBorderGrad.Rotation = (elapsed * 18) % 360
    outerHaloGradient.Rotation = (elapsed * 14) % 360
    goldEdgeGradient.Rotation = (elapsed * 18 + 34) % 360
    cursorGradient.Rotation = (elapsed * 55) % 360
    panelGradient.Rotation = 112 + math.sin(elapsed * 0.34) * 8
    for i, gr in ipairs(titleGradients) do
        if gr.Parent then gr.Rotation = math.sin(elapsed * 0.47 + i * 0.35) * 12 end
    end
    for i, gr in ipairs(borderGradients) do
        if gr.Parent then gr.Rotation = (elapsed * 14 + i * 38) % 360 end
    end
    for _, pic in ipairs(animatedImages) do
        pic.picture.Rotation = math.sin(elapsed * 0.72 + pic.index) * 1.55
        pic.picture.Position = UDim2.fromScale(-0.065 + math.sin(elapsed * 0.3 + pic.index) * 0.012,
            -0.065 + math.cos(elapsed * 0.33 + pic.index) * 0.012)
        pic.scan.Position = UDim2.new(0, 10, (elapsed * 0.18 + pic.index * 0.21) % 1, 0)
    end
    for _, particle in ipairs(particleList) do
        local p = particle.object
        p.Position = UDim2.new(particle.x, math.sin(elapsed * 0.4 + particle.phase) * 9,
            (particle.y - elapsed * particle.speed) % 1, 0)
        p.BackgroundTransparency = 0.40 + math.sin(elapsed + particle.phase) * 0.15
    end
end)

