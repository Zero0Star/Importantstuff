local function setJumpButtonState(enabled)
    jumpGradient.Color = enabled and ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(11, 69, 44)),
        ColorSequenceKeypoint.new(0.44, Color3.fromRGB(37, 151, 77)),
