    local function healthColor(ratio)
        if ratio > 0.6 then
            return Color3.fromRGB(100, 220, 130)
        elseif ratio > 0.3 then
            return Color3.fromRGB(240, 190, 60)
        else
            return Color3.fromRGB(230, 70, 70)
        end
    end
    local function makeRow(plr)
        if playerRows[plr] then return end
        local char = plr.Character
        local hum = getHumanoid(char)
        local hp = hum and hum.Health or 0
        local maxHp = hum and hum.MaxHealth or 100
        maxHp = maxHp == 0 and 100 or maxHp
        local ratio = math.clamp(hp / maxHp, 0, 1)

        local row = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = Color3.fromRGB(28, 24, 32),
            BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5
        }, PlayerScroll)
        Round(row, 10)
        Create("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(50, 38, 32)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(26, 26, 36))
            }), Rotation = 15
        }, row)
        Create("UIStroke", {Color = Gold, Transparency = 0.72, Thickness = 1}, row)

        local avatar = Create("ImageLabel", {
            Position = UDim2.fromOffset(9, 9), Size = UDim2.fromOffset(38, 38),
            BackgroundColor3 = Color3.fromRGB(44, 32, 24), BorderSizePixel = 0,
            Image = string.format("https://www.roblox.com/headshot-thumbnail/image?userId=%d&width=48&height=48&format=png", plr.UserId),
            ZIndex = 6
        }, row)
        Round(avatar, 10)
        Create("UIStroke", {Color = Gold, Transparency = 0.42, Thickness = 1}, avatar)

        local nameLabel = Create("TextLabel", {
            Position = UDim2.fromOffset(55, 7), Size = UDim2.new(1, -120, 0, 18),
            BackgroundTransparency = 1, Text = plr.DisplayName,
            TextColor3 = PaleGold, Font = Enum.Font.GothamBold, TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 6
        }, row)

        local hpLabel = Create("TextLabel", {
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 7),
            Size = UDim2.fromOffset(58, 18), BackgroundTransparency = 1,
            Text = string.format("%d / %d", math.floor(hp), math.floor(maxHp)),
            TextColor3 = healthColor(ratio), Font = Enum.Font.GothamMedium, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 6
        }, row)

        local barBg = Create("Frame", {
            Position = UDim2.fromOffset(55, 32), Size = UDim2.new(1, -68, 0, 9),
            BackgroundColor3 = Color3.fromRGB(38, 32, 42), BorderSizePixel = 0, ZIndex = 6
        }, row)
        Round(barBg, 5)

        local barFill = Create("Frame", {
            Size = UDim2.fromScale(ratio, 1), BackgroundColor3 = healthColor(ratio),
            BorderSizePixel = 0, ZIndex = 7
        }, barBg)
        Round(barFill, 5)
        Create("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(80, 220, 120)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(180, 255, 200)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 220, 120))
            }), Rotation = 90
        }, barFill)

        playerRows[plr] = {
            row = row, barFill = barFill, hpLabel = hpLabel,
            nameLabel = nameLabel, barBg = barBg
        }
        Empty.Visible = false
    end

    local function removeRow(plr)
        local data = playerRows[plr]
        if data then
            data.row:Destroy()
            playerRows[plr] = nil
        end
        local count = 0
        for _ in pairs(playerRows) do count = count + 1 end
        Empty.Visible = count == 0
        CountText.Text = count .. " ONLINE"
    end

    local function updateRow(plr)
        local data = playerRows[plr]
        if not data then return end
        local char = plr.Character
        local hum = getHumanoid(char)
        local hp = hum and hum.Health or 0
        local maxHp = hum and hum.MaxHealth or 100
        maxHp = maxHp == 0 and 100 or maxHp
        local ratio = math.clamp(hp / maxHp, 0, 1)
        local color = healthColor(ratio)
        Animate(data.barFill, 0.25, {Size = UDim2.fromScale(ratio, 1), BackgroundColor3 = color})
        data.hpLabel.Text = string.format("%d / %d", math.floor(hp), math.floor(maxHp))
        data.hpLabel.TextColor3 = color
    end

    local healthConnections = {}
    local function healthConnect(signal, callback)
        local connection = signal:Connect(callback)
        table.insert(healthConnections, connection)
        return connection
    end
    ScreenGui.Destroying:Connect(function()
        for _, connection in ipairs(healthConnections) do connection:Disconnect() end
        table.clear(healthConnections)
    end)

    local function hookPlayer(plr)
        if plr == LocalPlayer then return end
        makeRow(plr)
        local count = 0
        for _ in pairs(playerRows) do count = count + 1 end
        CountText.Text = count .. " ONLINE"
        healthConnect(plr.CharacterAdded, function(char)
            task.wait(0.2)
            if not ScreenGui.Parent then return end
            makeRow(plr)
            local hum = char:WaitForChild("Humanoid", 5)
            if hum and ScreenGui.Parent then
                updateRow(plr)
                healthConnect(hum:GetPropertyChangedSignal("Health"), function()
                    updateRow(plr)
                end)
                healthConnect(hum:GetPropertyChangedSignal("MaxHealth"), function()
                    updateRow(plr)
                end)
            end
        end)
        local char = plr.Character
        if char then
            local hum = getHumanoid(char)
            if hum and ScreenGui.Parent then
                updateRow(plr)
                healthConnect(hum:GetPropertyChangedSignal("Health"), function()
                    updateRow(plr)
                end)
                healthConnect(hum:GetPropertyChangedSignal("MaxHealth"), function()
                    updateRow(plr)
                end)
            end
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        hookPlayer(plr)
    end
    healthConnect(Players.PlayerAdded, hookPlayer)
    healthConnect(Players.PlayerRemoving, removeRow)

    local dragging, dragStart, startPos = false, nil, nil
    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    healthConnect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    CloseBtn.Activated:Connect(function()
        healthGui = nil
        setHealthButtonState(false)
        Animate(Main, 0.18, {GroupTransparency = 1})
        task.delay(0.2, function() ScreenGui:Destroy() end)
    end)
    MinBtn.Activated:Connect(function()
        local collapsed = Main.Size.Y.Offset < 90
        PlayerScroll.Visible = collapsed
        Animate(Main, 0.22, {
            Size = collapsed
                and UDim2.fromOffset(BaseWidth, BaseHeight)
                or UDim2.fromOffset(BaseWidth, 82)
        })
    end)

    local CanvasGroup = Main
    if CanvasGroup:IsA("CanvasGroup") then
        CanvasGroup.GroupTransparency = 1
        Animate(CanvasGroup, 0.26, {GroupTransparency = 0})
    end

    healthGui = ScreenGui
end

