    diskCorner.Parent = disk
    local diskStroke = Instance.new("UIStroke")
    diskStroke.Color = Color3.fromRGB(70, 255, 125)
    diskStroke.Thickness = 1.2
    diskStroke.Transparency = 0.5
    diskStroke.Parent = disk

    for _, ringRatio in ipairs({0.33, 0.66, 1}) do
        local ring = Instance.new("Frame")
        local sz = RADAR_RADIUS * 2 * ringRatio
        ring.AnchorPoint = Vector2.new(0.5, 0.5)
        ring.Position = UDim2.fromScale(0.5, 0.5)
        ring.Size = UDim2.fromOffset(sz, sz)
        ring.BackgroundTransparency = 1
        ring.BorderSizePixel = 0
        ring.Parent = disk
        local ringStroke = Instance.new("UIStroke")
        ringStroke.Color = Color3.fromRGB(70, 255, 125)
        ringStroke.Thickness = 0.8
        ringStroke.Transparency = 0.75
        ringStroke.Parent = ring
        local ringCorner = Instance.new("UICorner")
        ringCorner.CornerRadius = UDim.new(0.5, 0)
        ringCorner.Parent = ring
    end

    for _, axis in ipairs({"H", "V"}) do
        local line = Instance.new("Frame")
        line.AnchorPoint = Vector2.new(0.5, 0.5)
        line.Position = UDim2.fromScale(0.5, 0.5)
        line.Size = axis == "H"
            and UDim2.new(1, 0, 0, 1)
            or UDim2.new(0, 1, 1, 0)
        line.BackgroundColor3 = Color3.fromRGB(70, 255, 125)
        line.BackgroundTransparency = 0.84
        line.BorderSizePixel = 0
        line.ZIndex = 2
        line.Parent = disk
    end

    local selfDot = Instance.new("Frame")
    selfDot.Name = "SelfDot"
    selfDot.AnchorPoint = Vector2.new(0.5, 0.5)
    selfDot.Position = UDim2.fromScale(0.5, 0.5)
    selfDot.Size = UDim2.fromOffset(DOT_SIZE + 2, DOT_SIZE + 2)
    selfDot.BackgroundColor3 = Color3.fromRGB(180, 255, 200)
    selfDot.BorderSizePixel = 0
    selfDot.ZIndex = 10
    selfDot.Parent = disk
    local selfCorner = Instance.new("UICorner")
    selfCorner.CornerRadius = UDim.new(0.5, 0)
    selfCorner.Parent = selfDot

    local playerDots = {}
    local sweepAngle = 0

    local sweepRays = {}
    for i = 12, 0, -1 do
        local ray = make("Frame", disk, {
            Name = i == 0 and "Sweep" or "SweepTrail",
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.75, 0.5),
            Size = UDim2.fromOffset(RADAR_RADIUS - 3, 2),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = i == 0 and 0.08 or 0.79 + i * 0.015,
            BorderSizePixel = 0, ZIndex = i == 0 and 6 or 5,
        })
        gradient(ray, {Color3.fromRGB(130, 255, 170), Color3.fromRGB(45, 255, 105)}, 0,
            NumberSequence.new({NumberSequenceKeypoint.new(0, 0.08), NumberSequenceKeypoint.new(1, i == 0 and 0.35 or 0.85)}))
        table.insert(sweepRays, {object = ray, offset = i * 3})
    end

    local itemDots = {}
    local itemRefresh = 0.5
    local itemColor = Color3.fromRGB(100, 195, 255)

    local function addItem(obj, found)
        if found[obj] then return end
        if not (obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("Attachment") or obj:IsA("Folder")) then return end
        found[obj] = true
        if not itemDots[obj] then
            local marker = make("ImageLabel", disk, {
                Name = obj.Name .. "Marker",
                AnchorPoint = Vector2.new(0.5, 0.5),
                Size = UDim2.fromOffset(8, 8),
                BackgroundTransparency = 1,
                Image = "rbxassetid://95126386730533",
                ImageColor3 = itemColor,
                ScaleType = Enum.ScaleType.Fit,
                Visible = false,
                ZIndex = 9,
            })
            itemDots[obj] = marker
        end
    end

    local function refreshItems()
        local found = {}
        local rooms = workspace:FindFirstChild("CurrentRooms")
        local room50 = rooms and rooms:FindFirstChild("50")
        local assets = room50 and room50:FindFirstChild("Assets")
        local shelves = assets and assets:FindFirstChild("Bookshelves1")
        if shelves then
            for _, shelf in ipairs(shelves:GetDescendants()) do
                if shelf.Name == "Modular_Bookshelf" and shelf:IsA("Model") then
                    for _, obj in ipairs(shelf:GetDescendants()) do
                        if obj.Name == "LiveHintBook" then addItem(obj, found) end
                    end
                end
            end
        end
        local room100 = rooms and rooms:FindFirstChild("100")
        if room100 then
            for _, obj in ipairs(room100:GetDescendants()) do
                if obj.Name == "LiveBreakerPolePickup" then addItem(obj, found) end
            end
        end
        for obj, marker in pairs(itemDots) do
            if not found[obj] then
                marker:Destroy()
                itemDots[obj] = nil
            end
        end
    end

    local function itemPosition(obj)
        if obj:IsA("BasePart") then return obj.Position end
        if obj:IsA("Attachment") then return obj.WorldPosition end
        if obj:IsA("Model") then
            if obj:FindFirstChildWhichIsA("BasePart", true) then return obj:GetPivot().Position end
        else
            local part = obj:FindFirstChildWhichIsA("BasePart", true)
            if part then return part.Position end
        end
        return nil
    end

    local radarStep
    radarStep = RunService.Heartbeat:Connect(function(dt)
        if not radarScreen.Parent then
            radarStep:Disconnect()
            return
        end
        sweepAngle = (sweepAngle + dt * 90) % 360
        for _, data in ipairs(sweepRays) do
            local angle = sweepAngle - data.offset
            local radians = math.rad(angle)
            local halfLength = (RADAR_RADIUS - 3) * 0.5
            data.object.Position = UDim2.new(0.5, math.cos(radians) * halfLength, 0.5, math.sin(radians) * halfLength)
            data.object.Rotation = angle
        end

        local selfChar = LocalPlayer.Character
        local selfRoot = selfChar and selfChar:FindFirstChild("HumanoidRootPart")
        local camera = workspace.CurrentCamera
        local viewForward
        if camera then
            local look = camera.CFrame.LookVector
            viewForward = Vector3.new(look.X, 0, look.Z)
        end
        if not viewForward or viewForward.Magnitude < 0.001 then
            local look = selfRoot and selfRoot.CFrame.LookVector or Vector3.new(0, 0, -1)
            viewForward = Vector3.new(look.X, 0, look.Z)
        end
        if viewForward.Magnitude < 0.001 then
            viewForward = Vector3.new(0, 0, -1)
        end
        viewForward = viewForward.Unit
        local viewRight = Vector3.new(-viewForward.Z, 0, viewForward.X)

        itemRefresh = itemRefresh + dt
        if itemRefresh >= 0.5 then
            itemRefresh = 0
            refreshItems()
        end
        for obj, marker in pairs(itemDots) do
            local pos = obj:IsDescendantOf(workspace) and itemPosition(obj)
            if selfRoot and pos then
                local delta = pos - selfRoot.Position
                local offset = Vector2.new(delta:Dot(viewRight), -delta:Dot(viewForward)) / WORLD_RANGE
                if offset.Magnitude > 0.94 then offset = offset.Unit * 0.94 end
                marker.Position = UDim2.fromScale(0.5 + offset.X * 0.5, 0.5 + offset.Y * 0.5)
                marker.Visible = true
            else
                marker.Visible = false
            end
        end

        local activePlayers = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                activePlayers[plr] = true
                local char = plr.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root and selfRoot then
                    local delta = root.Position - selfRoot.Position
                    local offset = Vector2.new(delta:Dot(viewRight), -delta:Dot(viewForward)) / WORLD_RANGE
                    if offset.Magnitude > 0.94 then offset = offset.Unit * 0.94 end
                    local px = 0.5 + offset.X * 0.5
                    local pz = 0.5 + offset.Y * 0.5
                    if not playerDots[plr] then
                        local dot = Instance.new("Frame")
                        dot.AnchorPoint = Vector2.new(0.5, 0.5)
                        dot.Size = UDim2.fromOffset(DOT_SIZE, DOT_SIZE)
                        dot.BackgroundColor3 = Color3.fromRGB(75, 240, 115)
                        dot.BorderSizePixel = 0
                        dot.ZIndex = 8
                        dot.Parent = disk
                        local dc = Instance.new("UICorner")
                        dc.CornerRadius = UDim.new(0.5, 0)
                        dc.Parent = dot
                        local nameTag = Instance.new("TextLabel")
                        nameTag.AnchorPoint = Vector2.new(0.5, 1)
                        nameTag.Position = UDim2.new(0.5, 0, 0, -1)
                        nameTag.Size = UDim2.fromOffset(60, 12)
                        nameTag.BackgroundTransparency = 1
                        nameTag.Text = plr.Name
                        nameTag.TextColor3 = Color3.fromRGB(190, 255, 210)
                        nameTag.TextSize = 8
                        nameTag.Font = Enum.Font.GothamMedium
                        nameTag.TextTruncate = Enum.TextTruncate.AtEnd
                        nameTag.ZIndex = 9
                        nameTag.Parent = dot
                        playerDots[plr] = dot
                    end
                    playerDots[plr].Position = UDim2.fromScale(px, pz)
                    playerDots[plr].Visible = true
                elseif playerDots[plr] then
                    playerDots[plr].Visible = false
                end
            end
        end
        for plr, dot in pairs(playerDots) do
            if not activePlayers[plr] then
                dot:Destroy()
                playerDots[plr] = nil
            end
        end
    end)

    local dragging, dragStart, startPos = false, nil, nil
    container.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = container.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    local radarDragConnection = UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            container.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    radarScreen.Destroying:Connect(function()
        radarDragConnection:Disconnect()
        if radarStep.Connected then radarStep:Disconnect() end
    end)

    closeRadarBtn.Activated:Connect(function()
        radarStep:Disconnect()
        radarScreen:Destroy()
        if radarGui == radarScreen then
            radarGui = nil
            radarEnabled = false
            setRadarButtonState(false)
        end
    end)
end

