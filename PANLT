local function notify(message, success)
    toastToken = toastToken + 1
    local token = toastToken
    toastText.Text = message
    toastText.TextColor3 = success == false and Color3.fromRGB(255, 150, 130) or C.white
    local toastGold = toastText:FindFirstChildOfClass("UIGradient")
    if toastGold then toastGold.Enabled = success ~= false end
    toast.Visible = true
    tween(toast, {GroupTransparency = 0}, 0.17)
    task.delay(2.6, function()
        if not alive or toastToken ~= token then return end
        tween(toast, {GroupTransparency = 1}, 0.2)
        task.delay(0.22, function()
            if alive and toastToken == token then toast.Visible = false end
        end)
    end)
end

