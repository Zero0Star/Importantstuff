        local registered = setmetatable({}, {__mode = "k"})
        local function translate(value)
            if language == "en" or type(value) ~= "string" then return value end
            local index = language == "zh" and 1 or 2
            local exact = dictionary[value]
            if exact then return exact[index] end
            local prefix, suffix = value:match("^(.-)(  /  .*)$")
            if prefix and dictionary[prefix] then
                local rest = suffix:sub(6)
                local state, tail = rest:match("^(%a+)(.*)$")
                if state and dictionary[state] then rest = dictionary[state][index] .. tail end
                local unavailable = dictionary.Unavailable[index]
                rest = rest:gsub("%[Unavailable%]", "[" .. unavailable .. "]")
                rest = rest:gsub("KEY:", dictionary["KEY:"][index])
                return dictionary[prefix][index] .. "  /  " .. rest
            end
            local name = value:match("^‹  (.+)$")
            if name and dictionary[name] then return "‹  " .. dictionary[name][index] end
            name = value:match("^(.-)  ›$")
            if name and dictionary[name] then return dictionary[name][index] .. "  ›" end
            local number, term = value:match("^(%d+%s*/%s*)(%u+)$")
            if number and dictionary[term] then return number .. dictionary[term][index] end
            local left, right = value:match("^(.-) / (.+)$")
            if left and (dictionary[left] or dictionary[right]) then
                return (dictionary[left] and dictionary[left][index] or left) .. " / " .. (dictionary[right] and dictionary[right][index] or right)
            end
            return value
        end
        local function update(obj, record)
            if not obj.Parent then return end
            local result = translate(record.original)
            if result == obj.Text then return end
            record.writing = true
            record.rendered = result
            obj.Text = result
            record.writing = false
        end
        local function register(obj)
            if registered[obj] or not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then return end
            if obj:GetAttribute("CourageLanguageControl") then return end
            local record = {original = obj.Text, rendered = obj.Text, writing = false}
            registered[obj] = record
            connect(obj:GetPropertyChangedSignal("Text"), function()
                if record.writing or obj.Text == record.rendered then return end
                record.original = obj.Text
                record.rendered = obj.Text
                update(obj, record)
            end)
            update(obj, record)
        end
        local selector = make("Frame", landing, {Name = "LanguageSelector", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 0), Size = UDim2.fromOffset(318, 35), BackgroundTransparency = 1, ZIndex = 30})
        landingTop.Size = UDim2.new(1, -330, 0, 24)
        local buttons = {}
        local function selectLanguage(code)
            language = code
            for obj, record in pairs(registered) do update(obj, record) end
            for key, btn in pairs(buttons) do
                btn.BackgroundColor3 = key == code and C.bronze or C.dark2
                btn.TextColor3 = key == code and C.energy or C.pale
            end
        end
        for i, item in ipairs({{"zh", "中文"}, {"en", "English"}, {"ja", "日本語"}}) do
            local code = item[1]
            local btn = make("TextButton", selector, {Name = "Language_" .. code, Position = UDim2.fromOffset((i - 1) * 106, 0), Size = UDim2.fromOffset(100, 30), BackgroundColor3 = C.dark2, AutoButtonColor = false, Text = item[2], TextColor3 = C.pale, TextSize = 14, Font = Enum.Font.GothamMedium, ZIndex = 31})
            btn:SetAttribute("CourageLanguageControl", true)
            round(btn, 6)
            metal(stroke(btn, 0.12, 1.3))
            buttons[code] = btn
            connect(btn.Activated, function() clickSound(); selectLanguage(code) end)
        end
        for _, obj in ipairs(gui:GetDescendants()) do register(obj) end
        connect(gui.DescendantAdded, function(obj)
            task.defer(function() if alive and obj.Parent then register(obj) end end)
        end)
        selectLanguage("en")
    end
    connect(back.Activated, function()
        clickSound()
        goToPage(0)
    end)
    local zoomDriver = make("NumberValue", gui, {Value = 1})
    connect(zoomDriver.Changed, function(value)
        zoom = value
        syncGeometry()
    end)
    local function openPanel()
        if not alive or destroyPending or phase == "open" or phase == "opening" then return end
        stateToken = stateToken + 1
        local token = stateToken
        phase = "opening"
        gui.Enabled = true
        panel.Visible = true
        dim.Visible = true
        fx.GroupTransparency = 1
        fx.Visible = true
        portal.GroupTransparency = 0
        starBurstHolder.GroupTransparency = 0
        outerHalo.Visible = true
        goldEdge.Visible = true
        plasmaRing.Visible = true
        if activeTweens[panel] then activeTweens[panel]:Cancel() end
        if activeTweens[zoomDriver] then activeTweens[zoomDriver]:Cancel() end
        panel.GroupTransparency = 1
        zoomDriver.Value = 0.63
        panel.Position = UDim2.new(center.X.Scale, center.X.Offset, center.Y.Scale, center.Y.Offset + 32)
        syncGeometry()
        unlockCursor()
        tween(dim, {BackgroundTransparency = 0.24}, 0.48)
        tween(fx, {GroupTransparency = 0}, 0.58, Enum.EasingStyle.Quint)
        tween(plasmaRing, {ImageTransparency = 0.69}, 0.65)
        tween(outerHaloStroke, {Transparency = 0.72}, 0.6)
        tween(goldEdgeStroke, {Transparency = 0.12}, 0.55)
        if animEnabled then portalBurst(token, true) end
        task.delay(animEnabled and 0.12 or 0, function()
            if not valid(token) then return end
            tween(panel, {GroupTransparency = 0, Position = center}, 0.56, Enum.EasingStyle.Quint)
            tween(zoomDriver, {Value = 1}, 0.58, Enum.EasingStyle.Quint)
            sweepAcross()
        end)
        task.delay(0.72, function()
            if valid(token) then phase = "open" end
        end)
    end
    local cleanup
    local function closePanel(destroyAfter)
        if not alive or phase == "closed" or phase == "closing" then return end
        stateToken = stateToken + 1
        local token = stateToken
        phase = "closing"
        destroyPending = destroyAfter == true
        dragInput, dragStart, dragPosition = nil, nil, nil
        restoreCursor()
        playMagicSound()
        if animEnabled then portalBurst(token, false) end
        tween(panel, {GroupTransparency = 1}, 0.56, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        tween(zoomDriver, {Value = 0.68}, 0.58, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        tween(dim, {BackgroundTransparency = 1}, 0.56, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        tween(fx, {GroupTransparency = 1}, 0.58, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        tween(portal, {GroupTransparency = 1}, 0.58, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        tween(starBurstHolder, {GroupTransparency = 1}, 0.58, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        tween(sigilOverlay, {ImageTransparency = 1}, 0.56, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        tween(outerHaloStroke, {Transparency = 1}, 0.52, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        tween(goldEdgeStroke, {Transparency = 1}, 0.52, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        tween(plasmaRing, {ImageTransparency = 1}, 0.56, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        task.delay(0.7, function()
            if not valid(token) then return end
            panel.Visible = false
            dim.Visible = false
            fx.Visible = false
            outerHalo.Visible = false
            goldEdge.Visible = false
            plasmaRing.Visible = false
            portal.Visible = false
            sigilOverlay.Visible = false
            starBurstHolder.Visible = false
            for _, animation in pairs(activeTweens) do animation:Cancel() end
            table.clear(activeTweens)
            phase = "closed"
        end)
        if destroyAfter == true then
            task.delay(1.08, function()
                if valid(token) then cleanup(true) end
            end)
        end
    end
    local function togglePanel()
        if phase == "open" or phase == "opening" then closePanel() else openPanel() end
    end
    connect(close.Activated, function()
        clickSound()
        closePanel(true)
    end)
    connect(mobileIcon.Activated, function()
        clickSound()
        togglePanel()
    end)
    connect(mobileIcon.MouseButton1Down, function() tween(mobileScale, {Scale = 0.9}, 0.1) end)
    connect(mobileIcon.MouseButton1Up, function() tween(mobileScale, {Scale = 1}, 0.2, Enum.EasingStyle.Back) end)
    connect(UIS.InputBegan, function(input, processed)
        if processed or UIS:GetFocusedTextBox() then return end
        if input.KeyCode == Enum.KeyCode.L or input.KeyCode == Enum.KeyCode.RightShift then
            togglePanel()
        elseif input.KeyCode == Enum.KeyCode.Escape then
            closePanel()
        end
    end)
    connect(minBtn.Activated, function()
        if phase ~= "open" then return end
        clickSound()
        minimized = not minimized
        minBtn.Text = minimized and "+" or "−"
        pageHolder.Visible = not minimized
        footer.Visible = not minimized
        toast.Visible = false
        tween(panel, {Size = UDim2.fromOffset(840, minimized and 90 or 580)}, 0.35, Enum.EasingStyle.Quint)
        if not minimized then sweepAcross() end
    end)
    header.Active = true
    connect(header.InputBegan, function(input)
        if phase ~= "open" then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local p = input.Position
        if p.X >= header.AbsolutePosition.X + header.AbsoluteSize.X - 200 * viewScale then return end
        dragInput, dragStart, dragPosition = input, p, panel.Position
    end)
    connect(UIS.InputChanged, function(input)
        if not dragInput then return end
        if input ~= dragInput and not (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement) then return end
        local delta = input.Position - dragStart
        center = UDim2.new(dragPosition.X.Scale, dragPosition.X.Offset + delta.X, dragPosition.Y.Scale, dragPosition.Y.Offset + delta.Y)
        panel.Position = center
        syncGeometry()
    end)
    connect(UIS.InputEnded, function(input)
        if input == dragInput then dragInput = nil end
    end)
    connect(RS.RenderStepped, function(dt)
        if not alive then return end
        clock = clock + dt
        syncGeometry()
        frames, elapsed, statElapsed = frames + 1, elapsed + dt, statElapsed + dt
        if elapsed >= 1 then
            fps = math.floor(frames / elapsed + 0.5)
            frames, elapsed = 0, 0
        end
        if statElapsed >= 0.5 and panel.Visible then
            statElapsed = 0
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local ping = "N/A"
            pcall(function() ping = tostring(math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())) .. "ms" end)
            local pos = root and root.Position
            statsLine.Text = string.format("HP %s   •   FPS %d   •   PING %s   •   XYZ %s", hum and string.format("%d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth)) or "N/A", fps, ping, pos and string.format("%.0f %.0f %.0f", pos.X, pos.Y, pos.Z) or "N/A")
        end
        if not animEnabled then return end
        mobileSigilRing.Rotation = (clock * 24) % 360
        if phase == "closed" and not portal.Visible then return end
        for i, gr in ipairs(borderGradients) do
            if gr.Parent then gr.Rotation = (clock * 46 + i * 13) % 360 end
        end
        for i, gr in ipairs(titleGradients) do
            if gr.Parent then gr.Offset = Vector2.new(math.sin(clock * 1.5 + i * 0.3) * 0.22, 0) end
        end
        for _, data in ipairs(particleList) do
            data.y = (data.y - dt * data.speed) % 1
            data.object.Position = UDim2.fromScale((data.x + math.sin(clock * 0.6 + data.phase) * 0.035) % 1, data.y)
            data.object.BackgroundTransparency = 0.47 + 0.28 * math.sin(clock * 1.9 + data.phase)
            if data.isStar then data.object.Rotation = (clock * 22 + data.phase * 57) % 360 end
        end
        for _, data in ipairs(starParticleList) do
            data.y = (data.y - dt * data.speed) % 1
            local x = (data.x + math.sin(clock * data.drift + data.phase) * 0.018) % 1
            data.object.Position = UDim2.fromScale(x, data.y)
            data.object.Rotation = (data.object.Rotation + dt * data.spin) % 360
            data.object.ImageTransparency = 0.58 + 0.18 * math.sin(clock * data.pulse + data.phase)
        end
        local y = (clock * 0.22) % 1.12 - 0.06
        scanBeam.Position = UDim2.fromScale(0, y)
        scanGlow.Position = UDim2.fromScale(0, y)
        for i, star in ipairs(cornerStarList) do
            star.Rotation = (clock * 34 + i * 90) % 360
            star.ImageTransparency = 0.25 + 0.22 * math.sin(clock * 2 + i)
        end
        for _, data in ipairs(animatedImages) do
            if data.picture.Parent and landing.Visible then
                data.picture.Position = UDim2.fromScale(-0.065 + math.sin(clock * 0.7 + data.index) * 0.025, -0.065 + math.cos(clock * 0.6 + data.index) * 0.025)
                data.scan.Position = UDim2.new(0, 10, (clock * 0.29 + data.index * 0.3) % 1, 0)
                if data.core then
                    data.core.Rotation = (clock * (data.index == 2 and -21 or 16) + data.index * 37) % 360
                    data.core.ImageTransparency = 0.27 + 0.12 * math.sin(clock * 2.1 + data.index)
                    data.bezel.Rotation = (-clock * 9 + data.index * 15) % 360
                end
            end
        end
        headerSigilBg.Rotation = (clock * 17) % 360
        plasmaRing.Rotation = (clock * 8) % 360
        sigilOverlay.Rotation = (clock * 105) % 360
        cursorRing.Rotation = (clock * 110) % 360
        statusDotGlow.Transparency = 0.5 + math.sin(clock * 2.8) * 0.2
        if phase == "open" then
            outerHaloStroke.Transparency = 0.72 + math.sin(clock * 2) * 0.1
            cyanInnerStroke.Transparency = 0.7 + math.sin(clock * 1.6) * 0.13
        end
        for i, ring in ipairs(rings) do
            ring.Rotation = (clock * (i % 2 == 0 and -68 or 48) + i * 30) % 360
        end
    end)
    cleanup = function(destroy)
        if not alive then return end
        stateToken = stateToken + 1
        pageToken = pageToken + 1
        restoreCursor()
        RS:UnbindFromRenderStep(cursorStepName)
        for _, stop in pairs(featureStop) do pcall(stop) end
        alive = false
        for _, connection in ipairs(connections) do connection:Disconnect() end
        for _, animation in pairs(activeTweens) do animation:Cancel() end
        table.clear(connections)
        table.clear(activeTweens)
        if destroy and gui.Parent then gui:Destroy() end
    end
    connect(shutdown.Event, function() cleanup(true) end)
    connect(gui.Destroying, function() cleanup(false) end)
    openPanel()
    notify("SYSTEM / Loaded", true)
end
