            function o:OnChanged(fn) table.insert(self.Callbacks, fn); return self end
            function o:SetValue(v)
                if self.Value == v then return self end
                self.Value = v
                refresh()
                for _, fn in ipairs(self.Callbacks) do callback(fn, v) end
                return self
            end
            function o:SetValues(v) self.Values = v; refresh() end
            function o:GetState() return self.Value == true end
            function o:AddColorPicker(key, settings) return g:AddColorPicker(key, settings) end
