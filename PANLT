        TextTruncate = Enum.TextTruncate.AtEnd,
        TextStrokeColor3 = Color3.fromRGB(12, 20, 31),
        TextStrokeTransparency = 0.78,
    })
    for k, v in pairs(props or {}) do o[k] = v end
    gildText(o, (size or 14) >= 17)
    return o
end
