local function connect(signal, callback)
    local con = signal:Connect(callback)
    table.insert(connections, con)
    return con
end
local function make(className, parent, properties)
    local obj = Instance.new(className)
    for key, value in pairs(properties or {}) do obj[key] = value end
    obj.Parent = parent
    return obj
end
local function round(obj, radius)
    return make("UICorner", obj, {CornerRadius = UDim.new(0, radius or 12)})
end
local function stroke(obj, transparency, thickness)
    return make("UIStroke", obj, {
        Color = C.gold, Transparency = transparency or 0.4,
        Thickness = thickness or 1.2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
end
local function gradient(obj, colors, rotation, transparency)
    local points = {}
    for i, color in ipairs(colors) do
        points[i] = ColorSequenceKeypoint.new((i - 1) / (#colors - 1), color)
    end
    return make("UIGradient", obj, {
        Color = ColorSequence.new(points), Rotation = rotation or 0,
        Transparency = transparency or NumberSequence.new(0),
    })
end
local function metal(st)
    st.Color = Color3.fromRGB(255, 255, 255)
    local gr = gradient(st, {
        Color3.fromRGB(102, 56, 16),
        Color3.fromRGB(220, 153, 48),
        Color3.fromRGB(255, 248, 204),
        Color3.fromRGB(188, 111, 26),
        Color3.fromRGB(255, 223, 143),
        Color3.fromRGB(124, 68, 22),
    }, 22)
    table.insert(borderGradients, gr)
    return gr
end
local function gildText(o, large)
    o.TextColor3 = Color3.new(1, 1, 1)
    o.TextStrokeColor3 = Color3.fromRGB(38, 21, 10)
    o.TextStrokeTransparency = large and 0.57 or 0.79
    local gr = gradient(o, large and {
        Color3.fromRGB(163, 94, 25),
        Color3.fromRGB(255, 210, 113),
        Color3.fromRGB(255, 250, 215),
        Color3.fromRGB(234, 168, 65),
        Color3.fromRGB(255, 234, 159),
    } or {
        Color3.fromRGB(205, 151, 66),
        Color3.fromRGB(255, 228, 160),
        Color3.fromRGB(255, 249, 214),
        Color3.fromRGB(227, 174, 88),
    }, 0)
    if large then table.insert(titleGradients, gr) end
    return gr
end
local function tween(obj, goal, duration, style, direction)
    if not alive or not obj or not obj.Parent then return end
    local oldTween = activeTweens[obj]
    if oldTween then oldTween:Cancel() end
    local t = TS:Create(obj, TweenInfo.new(duration or 0.22, style or Enum.EasingStyle.Quad,
        direction or easeOut), goal)
    activeTweens[obj] = t
    t:Play()
    return t
end
local function label(parent, value, size, props)
