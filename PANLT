local function restoreNightVision()
    if not lightingBackup then return false end
    if nvBloom and nvBloom.Parent then nvBloom:Destroy() end
    nvBloom = nil
    for prop, value in pairs(lightingBackup.values) do
        pcall(function() Lighting[prop] = value end)
    end
    for _, item in ipairs(lightingBackup.atmospheres) do
        if item.object.Parent then
            pcall(function()
                item.object.Density = item.density
                item.object.Haze = item.haze
            end)
        end
    end
    for _, effect in ipairs(lightingBackup.removed) do effect.Parent = Lighting end
    lightingBackup, nightVisionEnabled = nil, false
    nvDescription.Text = "Illuminate everything"
    return true
end
local function enableNightVision()
    if nightVisionEnabled then return true end
    local names = {"GlobalShadows", "Brightness", "ExposureCompensation", "Ambient",
        "OutdoorAmbient", "FogEnd", "FogColor"}
    local backup = {values = {}, removed = {}, atmospheres = {}}
    for _, prop in ipairs(names) do backup.values[prop] = Lighting[prop] end
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") then
