    for _, child in ipairs(jumpButton:GetChildren()) do
        if child:IsA("TextLabel") then
            local gold = child:FindFirstChildOfClass("UIGradient")
            if gold then gold.Enabled = not enabled end
            child.TextColor3 = enabled and Color3.fromRGB(230, 255, 230) or C.white
        end
    end
end

local function restoreJump()
    local backup = jumpBackup
    jumpBackup = nil
    Humanoid = nil
    if not backup then return end
    if backup.character.Parent then
        backup.character:SetAttribute("CanJump", backup.canJump)
    end
    if backup.humanoid.Parent then
        backup.humanoid.UseJumpPower = backup.useJumpPower
        backup.humanoid.JumpPower = backup.jumpPower
        backup.humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, backup.jumping)
    end
end

local function SetupCharacter(Character)
    local token = jumpToken
    local hum = Character:WaitForChild("Humanoid", 10)
    if not hum or not hum:IsA("Humanoid") or not EnableJump or token ~= jumpToken or player.Character ~= Character then return end
    if Humanoid == hum then return end
    restoreJump()
    jumpBackup = {
        character = Character,
        humanoid = hum,
        canJump = Character:GetAttribute("CanJump"),
        useJumpPower = hum.UseJumpPower,
        jumpPower = hum.JumpPower,
        jumping = hum:GetStateEnabled(Enum.HumanoidStateType.Jumping),
    }
    Humanoid = hum
    Character:SetAttribute("CanJump", true)
    hum.UseJumpPower = true
    hum.JumpPower = JumpPower
    hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
end

local function disableJump()
    EnableJump = false
    jumpToken = jumpToken + 1
    if characterConnection then characterConnection:Disconnect() characterConnection = nil end
    if requestConnection then requestConnection:Disconnect() requestConnection = nil end
    restoreJump()
    setJumpButtonState(false)
end

connect(jumpButton.Activated, function()
    clickSound()
    if EnableJump then
        disableJump()
        notify("JUMPING / Disabled", true)
        return
    end
    EnableJump = true
    jumpToken = jumpToken + 1
    setJumpButtonState(true)
    characterConnection = player.CharacterAdded:Connect(SetupCharacter)
    requestConnection = UIS.JumpRequest:Connect(function()
        if not EnableJump or not Humanoid or not Humanoid.Parent or Humanoid.Health <= 0 then return end
        if Humanoid.Parent ~= player.Character then return end
        if InfiniteJumps or Humanoid.FloorMaterial ~= Enum.Material.Air then
            Humanoid.Jump = true
            Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
    if player.Character then task.spawn(SetupCharacter, player.Character) end
    notify("JUMPING / Enabled", true)
end)
featureUI.jumpButton = jumpButton
featureStop.jump = disableJump
end

