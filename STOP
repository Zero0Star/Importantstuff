            for _, row in ipairs(authorLabels) do
                row.TextSize = compact and 16 or math.clamp(math.floor(authorWidth / 24), 14, 18)
            end
            updateScrollCanvas()
        end
        refreshPopupLayout = layoutTheme
        connect(ContentViewport:GetPropertyChangedSignal("AbsoluteSize"), layoutTheme)
        layoutTheme()

        local function cleanup()
            if not alive then return end
            alive = false
            refreshPopupLayout, stylePopupCursor = nil, nil
            for _, connection in ipairs(connections) do
                connection:Disconnect()
            end
            for _, animation in pairs(tweens) do
                animation:Cancel()
            end
            table.clear(connections)
            table.clear(tweens)
        end
        connect(SG.Destroying, cleanup)

        if Theme.Motion then
            local elapsed, accumulator = 0, 0
            connect(RunService.RenderStepped, function(dt)
                if not alive then return end
                if not SG.Parent then cleanup() return end
                if not SG.Enabled then return end
                elapsed, accumulator = elapsed + dt, accumulator + dt
                if accumulator < 1 / Theme.AnimationFPS then return end
                accumulator = accumulator % (1 / Theme.AnimationFPS)
                mainBorderGradient.Rotation = (20 + elapsed * 16) % 360
                sideBorderGradient.Rotation = (160 - elapsed * 12) % 360
                authorBorderGradient.Rotation = (120 + elapsed * 14) % 360
                for index, goldGradient in ipairs(authorGradients) do
                    goldGradient.Offset = Vector2.new(math.sin(elapsed * 0.5 + index * 0.23) * 0.18, 0)
                end
                mainGradient.Rotation = 115 + math.sin(elapsed * 0.15) * 9
                creditGradient.Offset = Vector2.new(math.sin(elapsed * 0.55) * 0.3, 0)
                titleGradient.Offset = Vector2.new(math.sin(elapsed * 0.65) * 0.22, 0)
                recommendationGradient.Offset =
                    Vector2.new(math.sin(elapsed * 0.55) * 0.18, 0)
                scanner.Position = UDim2.new(0.04, 0, (elapsed * 0.13) % 1, 0)
                for index, state in ipairs(cards) do
                    state.sheen.Offset = Vector2.new(
                        ((elapsed / 5.8 + index * 0.17) % 1) * 2.4 - 1.2, 0)
                    state.borderGradient.Rotation =
                        (index * 32 + elapsed * 10) % 360
                end
                for _, particle in ipairs(particles) do
                    particle.object.Position = UDim2.new(particle.x,
                        math.sin(elapsed * 0.35 + particle.phase) * 12,
                        (particle.y - elapsed * particle.speed) % 1, 0)
                    particle.fade.base = 0.62
                        + math.sin(elapsed * 0.8 + particle.phase) * 0.15
                    particle.object.BackgroundTransparency =
                        1 - (1 - particle.fade.base) * backgroundVisibility
                end
                if cursorGradient and cursorGradient.Parent then
                    cursorGradient.Rotation = (elapsed * 70) % 360
                end
            end)
        end
    end
end


whenBossTimeReady(function(success)
    if not SG.Parent then return end
    if not success then
        SG:Destroy()
        return
    end
    SG.Enabled = true
    if refreshPopupLayout then refreshPopupLayout() end
    KJ4()
    if SG.Parent and not startBossTimeMusic() then KJ5() end
end)

