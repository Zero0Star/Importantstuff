local stopBossTimeMusic = function() end
local startBossTimeMusic = function() return false end
local whenBossTimeReady
do
    local AUDIO_URL = "https://raw.githubusercontent.com/Zero0Star/RipperNewSound/master/BossTime.mp3"
    local START_SECONDS = 110
    local TARGET_VOLUME = 1
    local FADE_IN_SECONDS = 1
    local OUTRO_SECONDS = 10
    local LOAD_TIMEOUT = 45

    local writeAudio, readAudio, audioExists, deleteAudio = writefile, readfile, isfile, delfile
    local customAsset = type(getcustomasset) == "function" and getcustomasset or getsynasset
    local cachePath
    local music, fadeTween
    local loopConnection, endedConnection, fadeConnection, destroyConnection
    local closing, disposed, started = false, false, false
    local readiness
    local readyCallbacks = {}
    local function publishReady(success)
        if readiness ~= nil then return end
        readiness = success
        for _, callback in ipairs(readyCallbacks) do
            task.defer(callback, success)
        end
        table.clear(readyCallbacks)
    end
    whenBossTimeReady = function(callback)
        if readiness ~= nil then
            task.defer(callback, readiness)
        else
            table.insert(readyCallbacks, callback)
        end
    end

    local function removeTempAudio()
        if not cachePath or type(deleteAudio) ~= "function" then return end
        local ok, exists = pcall(audioExists, cachePath)
        if not ok or exists then
            local removed, reason = pcall(deleteAudio, cachePath)
            if not removed and ok and exists then
                warn("[BossTime] Unable to remove temporary MP3: " .. tostring(reason))
            end
        end
    end

    local function disconnect(connection)
        if connection then connection:Disconnect() end
    end

    local function dispose()
        if disposed then return end
        disposed, closing = true, true
        disconnect(loopConnection)
        disconnect(endedConnection)
        disconnect(fadeConnection)
        disconnect(destroyConnection)
        loopConnection, endedConnection, fadeConnection, destroyConnection = nil, nil, nil, nil
        if fadeTween then
            fadeTween:Cancel()
            fadeTween = nil
        end
        if music then
            pcall(function()
                music.Volume = 0
                music:Stop()
                music:Destroy()
            end)
            music = nil
        end
        removeTempAudio()
        publishReady(false)
    end

    startBossTimeMusic = function()
        if closing or disposed or readiness ~= true or not music or not music.Parent then
            return false
        end
        if started then return true end
        local ok, reason = pcall(function()
            music.TimePosition = START_SECONDS
            music:Resume()
            started = true
            loopConnection = music.DidLoop:Connect(function()
                if not closing and not disposed and music and music.Parent then
                    music.TimePosition = START_SECONDS
                end
            end)
            fadeTween = TweenService:Create(music,
                TweenInfo.new(FADE_IN_SECONDS, Enum.EasingStyle.Quad,
                    Enum.EasingDirection.Out), {Volume = TARGET_VOLUME})
            fadeTween:Play()
        end)
        if not ok then
            warn("[BossTime] Playback failed: " .. tostring(reason))
            dispose()
        end
        return ok
    end

    stopBossTimeMusic = function()
        if closing or disposed then return end
        closing = true
        disconnect(destroyConnection)
        destroyConnection = nil
        disconnect(loopConnection)
        loopConnection = nil
        if fadeTween then
            fadeTween:Cancel()
            fadeTween = nil
        end

        
        if not started or not music or not music.Parent then
            dispose()
            return
        end

        local ok, reason = pcall(function()
            local outroDuration = math.min(OUTRO_SECONDS, music.TimeLength)
            music.Looped = false
            music.TimePosition = math.max(0, music.TimeLength - outroDuration)
            if not music.IsPlaying then music:Play() end
            endedConnection = music.Ended:Connect(dispose)
            fadeTween = TweenService:Create(music,
                TweenInfo.new(outroDuration, Enum.EasingStyle.Linear,
                    Enum.EasingDirection.Out), {Volume = 0})
            fadeConnection = fadeTween.Completed:Connect(function(state)
                if state == Enum.PlaybackState.Completed then dispose() end
            end)
            fadeTween:Play()
            
            task.delay(outroDuration + 0.25, dispose)
        end)
        if not ok then
            warn("[BossTime] Outro cleanup: " .. tostring(reason))
            dispose()
        end
    end

    destroyConnection = SG.Destroying:Connect(stopBossTimeMusic)

    local available = type(writeAudio) == "function"
        and type(readAudio) == "function"
        and type(audioExists) == "function"
        and type(deleteAudio) == "function"
        and type(customAsset) == "function"

    if not available then
        warn("[BossTime] Requires writefile/readfile/isfile/delfile and getcustomasset or getsynasset.")
        dispose()
    else
        local function isValidMP3(content)
            if type(content) ~= "string" or #content < 128 then return false end
            if content:sub(1, 3) == "ID3" then return true end
            local first, second = content:byte(1, 2)
            return first == 255 and second ~= nil and second >= 224
        end

        local function verifyAudio()
            local existsOK, exists = pcall(audioExists, cachePath)
            if not existsOK or not exists then return false end
            local readOK, content = pcall(readAudio, cachePath)
            return readOK and isValidMP3(content)
        end

        local function downloadAudio()
            local requestOK, content = pcall(function()
                return game:HttpGet(AUDIO_URL, true)
            end)
            if closing or disposed then return false end
            if not requestOK or not isValidMP3(content) then return false end
            local writeOK = pcall(writeAudio, cachePath, content)
            
            if closing or disposed then
                removeTempAudio()
                return false
            end
            if not writeOK or not verifyAudio() then
                removeTempAudio()
                return false
            end
            return true
        end

        task.spawn(function()
            local ok, reason = pcall(function()
                if closing or disposed or not SG.Parent then return end
                
                cachePath = "HardCoreOTS_BossTime_"
                    .. game:GetService("HttpService"):GenerateGUID(false) .. ".mp3"
                local retryDelay = 1
                while not closing and not disposed do
                    if verifyAudio() or downloadAudio() then break end
                    if closing or disposed then return end
                    task.wait(retryDelay)
                    retryDelay = math.min(retryDelay * 1.5, 8)
                end
                if closing or disposed then return end

                local assetOK, assetId = pcall(customAsset, cachePath)
                if closing or disposed then
                    removeTempAudio()
                    return
                end
                if not assetOK or type(assetId) ~= "string" or assetId == "" then
                    error("Unable to register BossTime custom asset")
                end

                music = Instance.new("Sound")
                music.Name = "HardCoreOTS_BossTime"
                music.SoundId = assetId
                music.Volume = 0
                music.PlaybackSpeed = 1
                music.Looped = true
                music.PlayOnRemove = false
                music.Parent = SoundService
                
                music:Play()
                local waited = 0
                while not closing and not disposed and music and music.Parent
                    and (not music.IsLoaded or music.TimeLength <= 0)
                    and waited < LOAD_TIMEOUT do
                    waited = waited + task.wait(0.1)
                end
                if closing or disposed then return end
                if not music or not music.Parent or not music.IsLoaded
                    or music.TimeLength <= 0 then
                    error("BossTime did not finish loading within " .. LOAD_TIMEOUT .. " seconds")
                end
                if music.TimeLength <= START_SECONDS then
                    error("BossTime must be longer than 110 seconds")
                end

                music:Pause()
                music.TimePosition = START_SECONDS
                publishReady(true)
            end)
            if not ok then
                if not closing then warn("[BossTime] " .. tostring(reason)) end
                dispose()
            end
        end)
    end
end


local function KJ5()
    if popupPhase == "closing" or popupPhase == "closed" or not SG.Parent then return end
    popupPhase = "closing"
    stopBossTimeMusic()
    removeCustomCursor()
    if mainMotionTween then mainMotionTween:Cancel() end
    if logMotionTween then logMotionTween:Cancel() end
    mainMotionTween = TweenService:Create(MC,
        TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {Position = mainClosedPosition})
    logMotionTween = TweenService:Create(CL,
        TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {Position = logClosedPosition})
    mainMotionTween:Play()
    logMotionTween:Play()
    TweenService:Create(CL, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
    TweenService:Create(CLTitle, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
    TweenService:Create(CLText, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
    TweenService:Create(CLLine, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
    TweenService:Create(CLStroke, TweenInfo.new(0.4), {Transparency = 1}):Play()
    TweenService:Create(BG, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {BackgroundTransparency = 1}):Play()
    wait(0.6)
    restoreMouseForDoors()
    popupPhase = "closed"
    SG:Destroy()
end

