local function updateScrollCanvas()
    local contentHeight = UIListLayout.AbsoluteContentSize.Y / popupDisplayScale + UIPadding.PaddingTop.Offset + UIPadding.PaddingBottom.Offset
    BC.Size = UDim2.new(1, 0, 0, contentHeight)
    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, contentHeight)
end

UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateScrollCanvas)
updateScrollCanvas()

local function KJ1()
    local containerHeight = ScrollFrame.AbsoluteSize.Y
    local buttonCount = 4
    local totalPadding = (buttonCount - 1) * UIListLayout.Padding.Offset + UIPadding.PaddingTop.Offset + UIPadding.PaddingBottom.Offset
    local availableHeight = containerHeight - totalPadding
    local buttonHeight = availableHeight / buttonCount
    return math.min(math.floor(buttonHeight * 0.3), 30)
end

local function updateButtonSizes()
    local textSize = KJ1()
    MB.TextSize = textSize
    PB.TextSize = textSize
    CB2.TextSize = textSize
    UB.TextSize = textSize
end

